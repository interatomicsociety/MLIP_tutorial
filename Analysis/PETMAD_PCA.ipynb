    "import chemiscope\n",
    "from ase.io import read\n",
    "from IPython.display import display\n",
    "\n",
    "dataset_path = \"dataset.xyz\"\n",
    "structures = read(dataset_path, index=\":\", format=\"extxyz\")\n",
    "\n",
    "widget = chemiscope.explore(structures, featurizer=\"pet-mad-1.0\")\n",
    "\n",
    "display(widget)"
